---
import { getYearsOfExperience } from '@repo/cv'
import { ArrowUpRight, Mail } from 'lucide-astro'
import BaseHead from '../components/BaseHead.astro'
import CVPreview from '../components/CVPreview.astro'
import Header from '../components/Header.astro'
import GithubIcon from '../components/icons/GithubIcon.astro'
import LinkedinIcon from '../components/icons/LinkedinIcon.astro'
import { config } from '../config'
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts'

const yearsOfExperience = getYearsOfExperience()

const skills = [
  'End-to-end product ownership: scoping, shipping and iterating',
  'Front-end specialist: React, Vue, TypeScript and design systems',
  'Back-end and architecture: Node.js APIs, PostgreSQL, multi-tenancy',
  'Technical leadership: DX, testing, code review and CI/CD',
  'AI engineering: production LLM agents, MCP, guardrails and evals',
]

const interests = [
  'Esports projects',
  'Entrepreneurship',
  'AI automation',
  'Developer Experience',
]
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header avatarFollowsHero />

    <main class="px-8 pb-16 flex justify-center max-md:px-4 max-md:pb-10">
      <div class="w-full max-w-xl">
        <!-- Hero -->
        <header class="pt-36 max-md:pt-28">
          <div data-hero-avatar class="w-20">
            <img
              src="/avatar.webp"
              alt={config.name}
              width="512"
              height="512"
              class="h-20 w-20 rounded-full object-cover ring-1 ring-white/10"
            />
          </div>

          <h1 class="mt-7 text-5xl max-md:text-[2rem] font-bold leading-[1.1] tracking-tight text-text">
            {config.role}.
          </h1>

          <p class="mt-5 text-text-secondary leading-relaxed">
            I'm Zeno, a senior software engineer with {yearsOfExperience}+ years of experience and
            co-founder of <a href="/projects/prefa" class="hero-link">Prefa Digital</a>. I own products
            end to end, from shaping the idea to shipping the back-end, the UI and everything in
            between, and I write <a href="/notes" class="hero-link">notes</a> about what I learn along the way.
          </p>

          <div class="mt-7 flex flex-wrap items-center gap-4">
            <div class="-ml-2 flex items-center gap-1">
              <a href={config.social.github} target="_blank" rel="noopener" aria-label="GitHub" class="p-2 rounded-lg text-text-muted hover:text-text transition-colors">
                <GithubIcon size={20} />
              </a>
              <a href={config.social.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" class="p-2 rounded-lg text-text-muted hover:text-text transition-colors">
                <LinkedinIcon size={20} />
              </a>
              <a href={`mailto:${config.email}`} aria-label="Email" class="p-2 rounded-lg text-text-muted hover:text-text transition-colors">
                <Mail size={20} />
              </a>
            </div>
          </div>
        </header>

        <!-- CV -->
        <section id="cv" class="scroll-mt-24 mt-20">
          <h2 class="font-mono text-xs uppercase tracking-wider text-accent mb-4">CV</h2>
          <a href="/cv" class="cv-card group flex items-center gap-6 rounded-xl border border-border p-5 transition-colors hover:border-accent/50">
            <div class="cv-sheet">
              <CVPreview />
            </div>
            <div class="flex flex-col gap-1.5">
              <span class="inline-flex items-center gap-1.5 font-medium text-text">
                View full CV
                <ArrowUpRight size={18} class="text-accent transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
              </span>
              <span class="text-sm text-text-muted">Experience, education and skills.</span>
            </div>
          </a>
        </section>

        <!-- Skills -->
        <section class="mt-12">
          <h2 class="font-mono text-xs uppercase tracking-wider text-accent mb-4">Skills</h2>
          <ul class="flex flex-col gap-2.5">
            {skills.map(skill => (
              <li class="flex gap-3 text-text-secondary">
                <span class="text-accent select-none mt-0.5">&rsaquo;</span>
                <span>{skill}</span>
              </li>
            ))}
          </ul>
        </section>

        <!-- Interests -->
        <section class="mt-12">
          <h2 class="font-mono text-xs uppercase tracking-wider text-accent mb-4">Interests</h2>
          <div class="flex flex-wrap gap-2">
            {interests.map(interest => (
              <span class="font-mono text-xs px-2.5 py-1 bg-tag-bg text-tag-text rounded">{interest}</span>
            ))}
          </div>
        </section>
      </div>
    </main>
  </body>
</html>

<style>
	/* A miniature of the whole first sheet, in A4 proportions. */
	.cv-sheet {
		flex: none;
		width: 160px;
		aspect-ratio: 210 / 297;
		overflow: hidden;
		border-radius: 3px;
		background: #f4f4f6;
		box-shadow: 0 10px 24px -8px rgb(0 0 0 / 0.5);
		transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.25, 1);
	}
	.cv-card:hover .cv-sheet {
		transform: translateY(-3px) rotate(-1.5deg);
	}

	@media (max-width: 768px) {
		.cv-sheet {
			width: 120px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cv-sheet {
			transition: none;
		}
	}

	.hero-link {
		color: var(--color-accent);
		text-decoration: none;
		transition: color 0.2s ease;
	}
	.hero-link:hover {
		color: var(--color-accent-hover);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
</style>
