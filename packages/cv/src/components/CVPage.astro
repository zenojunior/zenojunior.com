---
import type { ResumeData } from '../types';
import { careerStartYear } from '../experience';
import CVExperience from './CVExperience.astro';

interface Props {
  data: ResumeData;
}

const { data } = Astro.props;
// Wrap the "N+" in a span carrying the career start year, so the client script
// keeps it live in the browser. Year is sourced from config.yaml, never hardcoded.
const about = data.about.replace(/(\d+)\+/, `<span data-cv-live-years="${careerStartYear}">$1+</span>`);
---

<!-- Two A4 sheets, split at the same point as the canonical PDF:
     page 1 ends after Professional Experience, page 2 starts at Languages. -->
<div class="cv-pages">
  <div class="cv-page">
    <header class="cv-header">
      <h1 class="cv-name">{data.title}</h1>
      <p class="cv-location">{data.location}</p>
      <ul class="cv-contacts">
        {data.contacts.map((c) => (
          <li>
            {c.url ? (
              <a href={c.url} target="_blank" class:list={[{ 'cv-underline': c.underline }]}>{c.label}</a>
            ) : (
              c.label
            )}
          </li>
        ))}
      </ul>
    </header>

    <hr class="cv-divider" />

    <section class="cv-section">
      <h2 class="cv-section-title">Summary</h2>
      <p class="cv-about" set:html={about} />
    </section>

    <hr class="cv-divider" />

    <section class="cv-section">
      <h2 class="cv-section-title">Professional Experience</h2>
      {data.experiences.map((exp) => <CVExperience experience={exp} />)}
    </section>
  </div>

  <div class="cv-page">
    <section class="cv-section">
      <h2 class="cv-section-title">Languages</h2>
      <p class="cv-languages">{data.languages.join(' • ')}</p>
    </section>

    {data.notableProjects && data.notableProjects.length > 0 && (
      <>
        <hr class="cv-divider" />
        <section class="cv-section">
          <h2 class="cv-section-title">Volunteer Work</h2>
          {data.notableProjects.map((proj) => (
            <div class="cv-volunteer">
              <h3 class="cv-volunteer-title">
                {proj.link ? (
                  <a href={proj.link} target="_blank" class="cv-underline">{proj.title}</a>
                ) : proj.title}
              </h3>
              <p class="cv-volunteer-description">{proj.description}</p>
            </div>
          ))}
        </section>
      </>
    )}

    <hr class="cv-divider" />

    <section class="cv-section">
      <h2 class="cv-section-title">Skills</h2>
      <div class="cv-skills">
        {data.skills.map((skill) => (
          <p class="cv-skill-group">
            <strong>{skill.group}:</strong> {skill.items}
          </p>
        ))}
      </div>
    </section>

    <hr class="cv-divider" />

    <section class="cv-section">
      <h2 class="cv-section-title">Education</h2>
      {data.formation.map((edu) => (
        <div class="cv-education">
          <h3 class="cv-education-title">{edu.title}</h3>
          <p class="cv-education-school">
            {edu.company.name}{edu.period.end ? `, ${edu.period.end.slice(0, 4)}` : ''}
          </p>
        </div>
      ))}
    </section>
  </div>
</div>

<script>
  function fmt(d: string) {
    return new Date(d).toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
  }

  document.querySelectorAll<HTMLElement>('[data-cv-live-range]').forEach((el) => {
    const start = el.dataset.cvLiveRange!;
    el.textContent = `${fmt(start)} - Present`;
  });

  document.querySelectorAll<HTMLElement>('[data-cv-live-years]').forEach((el) => {
    const y = el.dataset.cvLiveYears!;
    el.textContent = `${new Date().getFullYear() - Number(y)}+`;
  });
</script>
